# Omarchy overlay for common/ghostty/config. Linked by the hatdots installer into
# ~/.config/hatdots/omarchy.ghostty (desktop-layer overlay, only linked when
# ~/.local/share/omarchy exists - see odd/tasks/hatdots-unify.md, task P3-5).
#
# Ghostty keeps the static Gentleman Theme palette (near-black background)
# on Omarchy too (user decision 2026-11-11, task P5-6). To follow Omarchy's
# active theme instead, uncomment the line below, or put it in
# ~/.config/hatdots/local.ghostty to opt in on one machine only;
# `omarchy-theme-set` then reloads ghostty with each theme change.
# config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"
