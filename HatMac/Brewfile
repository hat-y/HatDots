# ──────────────────────────────────────────────────────────────────────────────
# HatDots/HatMac — Brewfile para macOS
# Instalá todo con: brew bundle --file HatMac/Brewfile
# ──────────────────────────────────────────────────────────────────────────────

# ── Terminals (cask) ───────────────────────────────────────────────────────────
cask "ghostty"
cask "wezterm"

# ── Editor ─────────────────────────────────────────────────────────────────────
brew "neovim"

# ── Shell & plugins ────────────────────────────────────────────────────────────
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "powerlevel10k"

# ── Modern CLI tools (reemplazos) ──────────────────────────────────────────────
# tmux-continuum, tmux-resurrect, tmux-sensible, tmux-yank: son plugins de TPM,
# los instala `tmux.conf` automáticamente con `prefix + I`. No son fórmulas brew.
brew "tmux"
brew "ripgrep"
brew "fd"
brew "eza"
brew "zoxide"
brew "fzf"
brew "atuin"

# ── Git / Dev ──────────────────────────────────────────────────────────────────
brew "git"
brew "gh"
brew "lazygit"
brew "jq"
brew "bat"
brew "tree"

# ── RSS ────────────────────────────────────────────────────────────────────────
brew "newsboat"

# ── herdr (terminal server para agentes de IA) ─────────────────────────────────
# Binario Rust. Persiste sesiones de Claude Code / Codex / OpenCode / Cursor.
# Convive con tmux. Ver HatMac/herdr/README.md
brew "herdr"

# ── Fonts (cask) ───────────────────────────────────────────────────────────────
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka-nerd-font"

# ── Extras (opcional, descomentar si los usás) ────────────────────────────────
