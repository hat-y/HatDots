#!/usr/bin/env bash
# hat-sf-install — Instala las dependencias externas de Salesforce para HatDots/HatMac.
#
# Qué hace:
#   1. Descarga el .vsix de la extensión oficial de Salesforce para VS Code
#   2. Extrae el apex-jorje-lsp.jar (LSP server de Apex) y lo copia a:
#      ~/.local/share/nvim/mason/share/apex-language-server/apex-jorje-lsp.jar
#      (compatible con mason-lspconfig apex_ls spec)
#   3. Verifica que `sf` CLI esté instalado (v2, reemplaza a sfdx)
#
# Uso:
#   hat-sf-install                 # install
#   hat-sf-install --update        # re-descargar el JAR con la última versión
#   hat-sf-install --check         # solo verificar instalación
#
# Requiere: bash 4+, curl, java (>= 11), y brew con `sf` (o instalado manual).

set -euo pipefail

DEST_DIR="${HOME}/.local/share/nvim/mason/share/apex-language-server"
JAR_PATH="${DEST_DIR}/apex-jorje-lsp.jar"
TMP_DIR="$(mktemp -d)"

# Última release estable (no nightly) de salesforcedx-vscode.
# Si querés una específica, pasala como argumento: hat-sf-install v67.13.3
VERSION="${1:-v67.13.3}"
VSIX_URL="https://github.com/forcedotcom/salesforcedx-vscode/releases/download/${VERSION}/salesforcedx-vscode-apex-${VERSION}.vsix"

ACTION="install"

for arg in "$@"; do
	case "$arg" in
	--update) ACTION="update" ;;
	--check) ACTION="check" ;;
	-h|--help)
		echo "Uso: hat-sf-install [version] [--update] [--check]"
		echo "  Sin args: instala la última stable (v67.13.3)"
		echo "  hat-sf-install v67.12.1   instala una versión específica"
		exit 0
		;;
	esac
done

log() { printf '\033[1;36m▸\033[0m %s\n' "$*"; }
ok()  { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }

# ── Check ──────────────────────────────────────────────────────────────────────
if [ "$ACTION" = "check" ]; then
	command -v java >/dev/null 2>&1 && ok "java: $(java -version 2>&1 | head -1)" || err "java: no instalado"
	command -v sf >/dev/null 2>&1 && ok "sf CLI: $(sf --version 2>/dev/null | head -1)" || err "sf CLI: no instalado (brew install sf)"
	[ -f "$JAR_PATH" ] && ok "apex-jorje-lsp.jar: presente ($(du -h "$JAR_PATH" | cut -f1))" || err "apex-jorje-lsp.jar: ausente (corré hat-sf-install)"
	exit 0
fi

# ── Install / Update ──────────────────────────────────────────────────────────
log "Verificando java..."
if ! command -v java >/dev/null 2>&1; then
	err "java no está instalado. brew install openjdk@21 o instalá un JDK 11+."
	exit 1
fi
ok "java: $(java -version 2>&1 | head -1)"

log "Verificando sf CLI..."
if ! command -v sf >/dev/null 2>&1; then
	err "sf CLI no está instalado. brew install sf"
	exit 1
fi
ok "sf CLI: $(sf --version 2>/dev/null | head -1)"

log "Creando directorio ${DEST_DIR}..."
mkdir -p "$DEST_DIR"

# Cleanup trap
trap 'rm -rf "$TMP_DIR"' EXIT

# Buscar JAVA_HOME-aware java para unzip (algunos .vsix tienen paths largos)
log "Descargando salesforcedx-vscode-apex-${VERSION}.vsix..."
VSIX_PATH="${TMP_DIR}/apex.vsix"
if ! curl -fsSL -o "$VSIX_PATH" "$VSIX_URL"; then
	err "Falló la descarga desde $VSIX_URL"
	exit 1
fi

# Backup si estamos actualizando
if [ "$ACTION" = "update" ] && [ -f "$JAR_PATH" ]; then
	cp "$JAR_PATH" "${JAR_PATH}.bak"
	log "Backup: ${JAR_PATH}.bak"
fi

log "Extrayendo apex-jorje-lsp.jar..."
unzip -o -q "$VSIX_PATH" "extension/dist/apex-jorje-lsp.jar" -d "$TMP_DIR"

if [ ! -f "$TMP_DIR/extension/dist/apex-jorje-lsp.jar" ]; then
	err "No se encontró el JAR dentro del .vsix (¿release cambió de layout?)"
	exit 1
fi

mv "$TMP_DIR/extension/dist/apex-jorje-lsp.jar" "$JAR_PATH"
ok "JAR instalado en $JAR_PATH ($(du -h "$JAR_PATH" | cut -f1))"

log "Todo OK. Pasos siguientes:"
echo "  1. Reiniciá nvim (los treesitter parsers apex/soql/sosl/sflog se bajan automáticamente)"
echo "  2. Abrí un .cls y verificá que apex_ls se attacha con :lua = vim.lsp.get_active_clients()"
echo "  3. Las completions de sf CLI se cargan al abrir una terminal nueva"
