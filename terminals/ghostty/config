# ═══════════════════════════════════════════════════════════════════════════════
# GHOSTTY CONFIG — HatDots base + Omarchy theme integration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Theme dinámico (Omarchy) ──────────────────────────────────────────────────
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# ── Terminal ──────────────────────────────────────────────────────────────────

# Usar tmux como shell con sesión automática
command = /usr/bin/tmux -f ~/.tmux.conf new-session -A -s main

# Font
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-size = 12

# ── Window ────────────────────────────────────────────────────────────────────

background-opacity = 0.8
background-blur-radius = 20
background-opacity-cells = true

window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-step-resize = false
window-height = 100
window-width = 100

confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Ocultar tabs (usamos tmux)
gtk-tabs-location = hidden

# Permitir múltiples instancias
gtk-single-instance = false

# ── Shaders ───────────────────────────────────────────────────────────────────

custom-shader = shaders/cursor_smear_gentleman.glsl

# ── Cursor ───────────────────────────────────────────────────────────────────

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# ── Teclado ───────────────────────────────────────────────────────────────────

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

keybind = super+f=toggle_maximize
keybind = shift+enter=text:\x1b\r
keybind = alt+f4=close_window
keybind = alt+s=write_screen_file:paste

# Split resize
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# ── Rendimiento ───────────────────────────────────────────────────────────────

mouse-scroll-multiplier = 0.95
async-backend = epoll
